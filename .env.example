# Copy this file to ".env" and edit it for your machine.
DB_DIALECT=mssql
DB_HOST=localhost
DB_PORT=
DB_NAME=Bimbo
DB_USER=
DB_PASSWORD=
# true = Windows Authentication (leave DB_USER / DB_PASSWORD empty)
DB_TRUSTED_CONNECTION=true
# Must match a name printed by: python -c "import pyodbc; print(pyodbc.drivers())"
DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
# Only for DB_DIALECT=sqlite (demo database: see .env.demo)
DB_SQLITE_PATH=data/demo.db

# The two tables created in README section 3.2
FILTERED_TRAIN_TABLE=dbo.train_filtered
FILTERED_TEST_TABLE=dbo.test_filtered
